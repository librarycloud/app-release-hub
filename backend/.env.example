# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Admin API key — all /admin/* endpoints require X-API-Key: <this value>
ADMIN_API_KEY=change-me-to-a-secure-random-string

# ─── Storage ──────────────────────────────────────────────────────────────────
DB_PATH=data/hub.db
FILES_DIR=data/files

# ─── Download URL (optional) ──────────────────────────────────────────────────
# If set, file URLs returned to clients will be prefixed with this base URL.
# Useful when files are served via a CDN or a separate nginx host.
# Leave empty to use relative paths served by this Fastify server.
DOWNLOAD_BASE_URL=

# ─── GitHub Tokens (per app) ──────────────────────────────────────────────────
# Format: GITHUB_TOKEN_{APPID_UPPERCASE_WITH_UNDERSCORES}
# Example: app with appId "android-main" uses GITHUB_TOKEN_ANDROID_MAIN
# Leave empty for public repositories (no token needed).
GITHUB_TOKEN_ANDROID_MAIN=
# GITHUB_TOKEN_ANDROID_LITE=ghp_xxxx
# GITHUB_TOKEN_WIN_DESKTOP=ghp_yyyy

# Fallback global token (used if no per-app token is set)
GITHUB_TOKEN=
