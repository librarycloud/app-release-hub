# 基础服务配置
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# 后台管理密钥（必填，请生成随机长字符串）
ADMIN_API_KEY=your-secure-admin-api-key-here

# 数据持久化路径
DB_PATH=data/hub.db
FILES_DIR=data/files

# 可选：文件下载加速域名（如配置了 CDN 反代 /api/apps/*/releases/*）
DOWNLOAD_BASE_URL=

# 可选：全局 GitHub Token（私有仓库或避免 API 限频使用）
GITHUB_TOKEN=

# 自动轮询同步周期（分钟，默认 60，填 0 禁用定时轮询）
AUTO_SYNC_INTERVAL_MINUTES=60

# ====== 新增进阶配置 ======

# 存储类型：local（本地磁盘）或 s3（兼容 AWS S3 / 阿里云 OSS / 腾讯云 COS / MinIO）
STORAGE_TYPE=local

# S3 / OSS 对象存储配置（当 STORAGE_TYPE=s3 时生效）
S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
S3_REGION=oss-cn-hangzhou
S3_BUCKET=my-app-releases
S3_ACCESS_KEY=your-access-key-id
S3_SECRET_KEY=your-secret-access-key
# 公开 App 的 S3/CDN 下载域名（未配置时默认使用 S3 预签名 URL）
S3_PUBLIC_DOMAIN=https://cdn.example.com

# Nginx 内部重定向加速（可选，仅 local 模式配合 Nginx 时使用）
ENABLE_NGINX_ACCEL=false
NGINX_INTERNAL_PATH_PREFIX=/internal-files

# 并发与限流保护
MAX_CONCURRENT_BSDIFF=2
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_DOWNLOADS=30
